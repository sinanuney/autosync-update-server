#!/bin/bash
export PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$PATH"
echo "============================================================"
echo "  AUTOSYNC RESOLVE STUDIO - macOS OTOMATIK KURULUM"
echo "============================================================"

INSTALL_DIR="$HOME/.autosync-resolve-app"
mkdir -p "$INSTALL_DIR"
TMP_ZIP="/tmp/autosync_macos_payload.zip"

awk '/^__PAYLOAD_BEGINS__/ {p=1; next} p' "$0" | base64 -D > "$TMP_ZIP" 2>/dev/null || awk '/^__PAYLOAD_BEGINS__/ {p=1; next} p' "$0" | base64 -d > "$TMP_ZIP"
unzip -oq "$TMP_ZIP" -d "$INSTALL_DIR"
rm -f "$TMP_ZIP"

APP_BUNDLE="$INSTALL_DIR/AutoSync Resolve Studio.app"
chmod +x "$APP_BUNDLE/Contents/MacOS/AutoSyncResolveStudio"
chmod +x "$INSTALL_DIR/Kurulum_ve_Baslat_Mac.command"
xattr -cr "$APP_BUNDLE" 2>/dev/null

if ! command -v node >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "[*] Node.js kuruluyor..."
  brew install node
fi
if ! command -v ffmpeg >/dev/null 2>&1 && command -v brew >/dev/null 2>&1; then
  echo "[*] FFmpeg kuruluyor..."
  brew install ffmpeg
fi

SWIFT_SRC="$APP_BUNDLE/Contents/Resources/app/macos/AutoSyncResolveStudio.swift"
NATIVE_BIN="$APP_BUNDLE/Contents/MacOS/AutoSyncResolveStudioBin"
if command -v swiftc >/dev/null 2>&1 && [ -f "$SWIFT_SRC" ]; then
  echo "[*] Native macOS arayuzu derleniyor..."
  swiftc -O "$SWIFT_SRC" -o "$NATIVE_BIN" -framework Cocoa 2>/dev/null
  chmod +x "$NATIVE_BIN" 2>/dev/null
fi

cp -R "$APP_BUNDLE" "/Applications/AutoSync Resolve Studio.app" 2>/dev/null
cp -R "$APP_BUNDLE" "$HOME/Desktop/AutoSync Resolve Studio.app" 2>/dev/null
xattr -cr "/Applications/AutoSync Resolve Studio.app" "$HOME/Desktop/AutoSync Resolve Studio.app" 2>/dev/null

echo "[OK] Kurulum tamamlandi! AutoSync Resolve Studio baslatiliyor..."
open "$HOME/Desktop/AutoSync Resolve Studio.app" || open "$APP_BUNDLE"
exit 0
__PAYLOAD_BEGINS__
